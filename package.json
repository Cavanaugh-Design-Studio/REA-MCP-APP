{
  "name": "rea-mcp-app",
  "version": "0.1.0",
  "private": true,
  "description": "A leanrea-powered investigation workbench with internal execution agents.",
  "type": "module",
  "imports": {
    "#javascript-analysis-worker": "./dist/retained/composition/javascriptAnalysisWorkerProcess.js"
  },
  "license": "MIT",
  "files": [
    "dist",
    "leanrea",
    "docs",
    "third_party",
    "scripts/launch.mjs",
    "native/windows/build",
    "bridge/ghidra",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "bin": {
    "rea-mcp-app": "scripts/launch.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/launch.mjs",
    "preview": "node scripts/preview.mjs",
    "verify:provider": "node scripts/verify-provider.mjs",
    "verify:capabilities": "node --test tests/capabilities.test.mjs",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:parity:strict": "node scripts/verify-parity.mjs --require-full",
    "build:windows-native": "node scripts/build-windows-native.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "8.0.4",
    "@electron/asar": "4.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "2.15.0",
    "canonicalize": "3.0.0",
    "diff": "9.0.0",
    "parse5": "8.0.1",
    "pino": "10.4.0",
    "playwright-core": "1.58.2",
    "plist": "5.0.0",
    "write-file-atomic": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.4",
    "@types/write-file-atomic": "4.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
