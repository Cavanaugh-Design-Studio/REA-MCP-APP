# Supply these in the host environment, or select an env file with Node --env-file.
# No environment file is discovered automatically. Never commit a real API key.
REA_AI_ENABLED=false
OPENROUTER_API_KEY=
REA_AI_ANALYST_MODEL=
# REA_AI_REVIEWER_MODEL=
# REA_AI_ANALYST_REPORT_FORMAT=json-schema
# REA_AI_REVIEWER_REPORT_FORMAT=json-schema
# REA_PROJECT_STORE=C:/analysis/rea-mcp-app/projects.sqlite
# Optional existing conservative spending admission; configure both together.
# REA_AI_SPEND_LIMIT_USD=1
# REA_AI_SPEND_LEDGER=C:/analysis/rea-mcp-app/spend.sqlite
# Windows x64: directory containing a matching manifest.json and verified addon.
# REA_WINDOWS_NATIVE_DIR=C:/analysis/REA-MCP-APP/native/windows/build
# Optional caller-installed native engine and JDK; no installation is automatic.
# REA_GHIDRA_INSTALL_DIR=C:/analysis/tools/ghidra
# REA_GHIDRA_JAVA_HOME=C:/analysis/tools/jdk
# Optional caller-installed adb. Device capture always requires an exact serial.
# REA_ADB_PATH=C:/analysis/tools/platform-tools/adb.exe
# Optional result budget; larger values require a matching client receive buffer.
# REA_MCP_MAX_RESPONSE_BYTES=10485760

# Optional OpenTelemetry traces + metrics. Disabled unless explicitly enabled.
# Requires a caller-provided OTLP/HTTP JSON collector; nothing is installed.
REA_OTEL_ENABLED=false
# Base URL: REA appends /v1/traces and /v1/metrics.
# REA_OTEL_ENDPOINT=http://127.0.0.1:4318

# Optional internal Brave Search. The caller must also set allow_web_search=true.
# Queries go to Brave; never include private code or sensitive values.
# BRAVE_SEARCH_API_KEY=
