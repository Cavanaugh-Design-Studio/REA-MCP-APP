# REA reads environment variables from the process or MCP host configuration.
# It does not automatically load this file. Copy the settings you need into
# the environment used to launch REA; keep credentials in your host's secret store.

# Provider selection: auto, or an explicit provider ID supported by this build.
REA_ANALYSIS_PROVIDER=auto

# Logging: trace, debug, info, warn, error, fatal, or silent.
REA_LOG_LEVEL=info

# Optional MCP settings. Leave unset to use the built-in defaults.
# REA_MCP_INPUT_SCHEMA_PROFILE=full
# REA_MCP_MAX_RESPONSE_BYTES=16777216

# Optional OpenRouter reasoning for the MCP App. Enable only when you have
# selected model IDs and an OpenRouter API key. Never commit real credentials.
# REA_AI_ENABLED=true
# OPENROUTER_API_KEY=
# REA_AI_ANALYST_MODEL=
# REA_AI_REVIEWER_MODEL=

# Optional provider-specific absolute paths. Uncomment and set only when needed.
# REA_IDA_MCP_CONFIG=/absolute/path/to/ida-mcp.json
# GHIDRA_INSTALL_DIR=/absolute/path/to/ghidra
# JAVA_HOME=/absolute/path/to/jdk
# REA_GHIDRA_STARTUP_TIMEOUT_MS=330000
# REA_GHIDRA_NATIVEAOT_JAR=/absolute/path/to/rea-ghidra-nativeaot.jar
# REA_ILSPY_CMD_PATH=/absolute/path/to/ilspycmd
# HOPPER_LAUNCHER_PATH=/absolute/path/to/hopper
